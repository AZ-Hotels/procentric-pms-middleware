# Daily TV resync (FIAS fallback)
# Copy to /etc/cron.d/pms-middleware  or  install per "crontab -e" as root
# Cron runs every minute; resync_cron.php gates by resync.checkout_time / checkin_time in config.json.
* * * * * root /usr/bin/php /var/www/html/resync_cron.php --checkout >> /var/www/html/logs/resync_cron.log 2>&1
* * * * * root /usr/bin/php /var/www/html/resync_cron.php --checkin  >> /var/www/html/logs/resync_cron.log 2>&1
